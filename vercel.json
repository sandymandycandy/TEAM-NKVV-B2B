{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(css|js|uploads)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/vendor-sidebar.js",
      "dest": "/public/vendor-sidebar.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
