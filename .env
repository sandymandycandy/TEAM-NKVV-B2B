# .env

# Your MongoDB connection string for a local instance.
# The standard port is 27017. You can change `scubeg_db` to your desired database name.
MONGO_URI="mongodb://localhost:27017/scubeg_db"

# A strong, random string for your application's JWT secret.
JWT_SECRET="a-very-long-and-secure-random-string-for-your-app"
